{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "thesis_coordination_manifest",
  "type": "object",
  "required": [
    "schema_version",
    "thesis_case",
    "active_mode",
    "linked_cases",
    "readiness_gates",
    "blockers",
    "next_action"
  ],
  "properties": {
    "schema_version": {
      "type": "integer"
    },
    "thesis_case": {
      "type": "string"
    },
    "active_mode": {
      "type": "string",
      "enum": [
        "query_or_check",
        "reading",
        "empirical_asset_building",
        "thesis_writing",
        "integration"
      ]
    },
    "linked_cases": {
      "type": "array",
      "description": "Business child_cases under the four business subagents only."
    },
    "coordination_cases": {
      "type": "array",
      "description": "Optional governance/orchestration cases such as Subagent_check and Subagent_integrate child_cases. These must not be mixed into linked_cases.",
      "items": {
        "type": "object",
        "required": [
          "subagent",
          "child_case",
          "relative_path",
          "role",
          "role_category",
          "status"
        ],
        "properties": {
          "subagent": {
            "type": "string"
          },
          "child_case": {
            "type": "string"
          },
          "relative_path": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "role_category": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      }
    },
    "readiness_gates": {
      "type": "object"
    },
    "blockers": {
      "type": "array"
    },
    "next_action": {
      "type": "string"
    }
  }
}
