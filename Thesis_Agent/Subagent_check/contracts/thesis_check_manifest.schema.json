{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "thesis_check_manifest",
  "type": "object",
  "required": [
    "schema_version",
    "thesis_case",
    "coordination_case_ref",
    "check_scope",
    "focus_targets",
    "check_tracks",
    "scan_policy",
    "report_preferences"
  ],
  "properties": {
    "schema_version": {
      "type": "integer"
    },
    "thesis_case": {
      "type": "string"
    },
    "coordination_case_ref": {
      "type": "string"
    },
    "check_scope": {
      "type": "object"
    },
    "focus_targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "selector_type"
        ],
        "properties": {
          "selector_type": {
            "type": "string",
            "enum": [
              "by_role",
              "by_case_ref"
            ]
          },
          "role": {
            "type": "string"
          },
          "case_ref": {
            "type": "string"
          },
          "subagent": {
            "type": "string"
          },
          "child_case": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "check_tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "track_name"
        ],
        "properties": {
          "track_name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "track_config": {
            "type": "object"
          },
          "target_selectors": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "selector_type"
              ],
              "properties": {
                "selector_type": {
                  "type": "string",
                  "enum": [
                    "by_role",
                    "by_case_ref"
                  ]
                },
                "role": {
                  "type": "string"
                },
                "case_ref": {
                  "type": "string"
                },
                "subagent": {
                  "type": "string"
                },
                "child_case": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "scan_policy": {
      "type": "object"
    },
    "report_preferences": {
      "type": "object"
    },
    "last_resolved_target_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
