{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "writing_chapter_manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authoring_mode",
    "chapters"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "authoring_mode": {
      "type": "string",
      "enum": [
        "markdown",
        "direct_latex"
      ]
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "order",
          "kind",
          "zh_source",
          "zh_target"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "order": {
            "type": "integer"
          },
          "kind": {
            "type": "string",
            "enum": [
              "abstract",
              "chapter",
              "acknowledgement"
            ]
          },
          "zh_source": {
            "type": "string"
          },
          "en_source": {
            "type": [
              "string",
              "null"
            ]
          },
          "zh_target": {
            "type": "string"
          },
          "en_target": {
            "type": [
              "string",
              "null"
            ]
          },
          "upstream_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
