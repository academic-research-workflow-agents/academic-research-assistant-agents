{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "writing_case_manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "authoring_mode",
    "languages",
    "upstream_sources",
    "template",
    "manifests",
    "output_policy"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "case_title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "authoring_mode": {
      "type": "string",
      "enum": [
        "markdown",
        "direct_latex"
      ]
    },
    "markdown_renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "reader_format",
        "writer_format",
        "extra_args"
      ],
      "properties": {
        "engine": {
          "type": "string",
          "minLength": 1
        },
        "reader_format": {
          "type": "string",
          "minLength": 1
        },
        "writer_format": {
          "type": "string",
          "minLength": 1
        },
        "extra_args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "zh",
          "en"
        ]
      },
      "minItems": 2,
      "uniqueItems": true
    },
    "upstream_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subagent",
          "case_id",
          "path",
          "role"
        ],
        "properties": {
          "subagent": {
            "type": "string"
          },
          "case_id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_path",
        "worktree_path"
      ],
      "properties": {
        "asset_path": {
          "type": "string"
        },
        "worktree_path": {
          "type": "string"
        },
        "cover_config_path": {
          "type": "string"
        }
      }
    },
    "manifests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chapter_manifest",
        "asset_manifest",
        "build_manifest"
      ],
      "properties": {
        "chapter_manifest": {
          "type": "string"
        },
        "asset_manifest": {
          "type": "string"
        },
        "build_manifest": {
          "type": "string"
        }
      }
    },
    "output_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "build_dir",
        "preview_dir",
        "runtime_dir"
      ],
      "properties": {
        "build_dir": {
          "type": "string"
        },
        "preview_dir": {
          "type": "string"
        },
        "runtime_dir": {
          "type": "string"
        }
      }
    }
  }
}
