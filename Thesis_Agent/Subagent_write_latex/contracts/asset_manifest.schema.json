{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "writing_asset_manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assets"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id",
          "type"
        ],
        "properties": {
          "asset_id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "table",
              "figure",
              "summary",
              "spec",
              "other"
            ]
          },
          "source_path": {
            "type": "string"
          },
          "fragment_mode": {
            "type": "string",
            "enum": [
              "embedded_metadata",
              "metadata_shell"
            ]
          },
          "fragment_source_path": {
            "type": "string"
          },
          "fragment_source_path_zh": {
            "type": "string"
          },
          "fragment_source_path_en": {
            "type": "string"
          },
          "upstream_ref": {
            "type": "string"
          },
          "chapter_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "title": {
            "type": "string"
          },
          "title_en": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "note_en": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "draft",
              "ignored"
            ]
          }
        }
      }
    }
  }
}
